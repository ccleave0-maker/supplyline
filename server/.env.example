# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/supplyline"
TEST_DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/supplyline_test"

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
ENCRYPTION_KEY=""

CORS_ORIGINS="http://localhost:3000"
APP_URL="http://localhost:3000"
DEV_SHOW_LOGIN_CODE="false"

# console | smtp (e.g. Gmail) | resend | sendgrid
EMAIL_PROVIDER="console"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_ADDRESS=""
RESEND_API_KEY=""
SENDGRID_API_KEY=""
EMAIL_FROM_ADDRESS="no-reply@example.com"
EMAIL_FROM_NAME="Bowron"

# local | supabase
STORAGE_PROVIDER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="supplyline"

GOOGLE_CLIENT_ID=""
GEOCODER_CONTACT_EMAIL="you@example.com"

# --- Schedule, reminders and PO follow-ups ---
SCHEDULE_TIMEZONE="America/Vancouver"
DELIVERY_REMINDERS="on"
# Optional: lets an outside hourly job call POST /api/cron/reminders
CRON_SECRET=""

# --- AI (Phase 7) ---
# Each organization adds its own Claude key on Admin > AI (stored encrypted).
# Optional: the platform owner's key, used ONLY for organizations you allow on the Platform page, within their cap.
PLATFORM_ANTHROPIC_API_KEY=""
