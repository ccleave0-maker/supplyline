{
  "name": "@supplyline/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-4000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup-private": "tsx prisma/setup-private.ts",
    "db:reset": "prisma migrate reset --force",
    "push:keys": "tsx scripts/push-keys.ts",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supplyline/core": "workspace:*",
    "dotenv": "^17.0.0",
    "exceljs": "^4.4.0",
    "jose": "^6.0.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "next": "16.4.0",
    "nodemailer": "^10.0.16",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
